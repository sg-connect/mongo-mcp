# Production clusters. Copy to .env.production (git-ignored) on the VM and fill in.
#
# One variable per cluster. The name must match a "uriEnv" in
# config/connections.json. Connections marked "production": true also get
# full-collection-scan rejection and read from secondaries.
#
# Never commit the filled-in file and never paste these values into Claude.

PRODUCTION_CLUSTER0_URI=
# PRODUCTION_CLUSTER1_URI=
